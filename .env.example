# Copy to .env (ignored, chmod 600). Set separate, locally generated, URL-safe database passwords.
MUSIC_ADMIN_PASSWORD=
MUSIC_WRITER_PASSWORD=
MUSIC_API_PASSWORD=
WEB_PORT=8080

# API only: true = fixture responses; false = SQL aggregates from PostgreSQL (no upstream calls).
MUSIC_FIXTURE_MODE=true
# Worker only: true (default) = no upstream calls, jobs idle. Set false ONLY for real actions
# (bootstrap-import/sync/enrich, continuous worker); then recreate the worker.
MUSIC_WORKER_FIXTURE_MODE=true

MUSIC_PUBLIC_EVENT_FEEDS_ENABLED=false

# Real-data mode only. Worker is the only service that receives these. Never paste the token
# in chat/issues/logs. Missing values fail with an actionable error at the real-data action.
LISTENBRAINZ_USERNAME=
LISTENBRAINZ_TOKEN=

# Worker, real-data enrichment only. Required (no default); public MusicBrainz/ListenBrainz
# metadata calls need a descriptive contact, e.g. 'music-dashboard/0.1 (mailto:you@example.org)'.
MUSIC_METADATA_USER_AGENT=

# Optional worker tuning; values shown are the code defaults (forwarded to the worker).
# Hourly automatic refresh (same admission as POST /api/refresh; 10 min cooldown applies).
# MUSIC_REFRESH_AUTO_INTERVAL_SECONDS=3600
# MUSIC_SYNC_OVERLAP_HOURS=72
# MUSIC_RECONCILE_INTERVAL_SECONDS=604800
# MUSIC_EXPORT_MAX_BYTES=67108864
# MUSIC_METADATA_EMPTY_TTL_DAYS=7
# MUSIC_METADATA_POSITIVE_TTL_DAYS=30
# MUSIC_METADATA_RETRY_BASE_SECONDS=30
# MUSIC_METADATA_RETRY_MAX_SECONDS=86400
# MUSIC_ENRICHMENT_BATCH_SIZE=100
