          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "listens": {
            "minimum": 0.0,
            "title": "Listens",
            "type": "number"
          },
          "share": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Share",
            "type": "number"
          }
        },
        "required": [
          "key",
          "label",
          "is_other",
          "listens",
          "share"
        ],
        "title": "PieSlice",
        "type": "object"
      },
      "RankedEntity": {
        "additionalProperties": false,
        "properties": {
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Artwork URL; null until artwork enrichment (placeholder)",
            "title": "Image Url"
          },
          "key": {
            "description": "Stable MBID or normalized namespaced fallback identity",
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "listens": {
            "minimum": 0.0,
            "title": "Listens",
            "type": "number"
          },
          "mbid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mbid"
          },
          "metadata_state": {
            "enum": [
              "resolved",
              "unmapped",
              "missing"
            ],
            "title": "Metadata State",
            "type": "string"
          },
          "share": {
            "description": "Fraction of dimension included listens",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Share",
            "type": "number"
          }
        },
        "required": [
          "key",
          "label",
          "mbid",
          "metadata_state",
          "listens",
          "share"
        ],
        "title": "RankedEntity",
        "type": "object"
      },
      "RankingResponse": {
        "additionalProperties": false,
