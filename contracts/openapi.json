            "type": "string"
          }
        },
        "required": [
          "range",
          "coverage",
          "last_updated",
          "generation",
          "fixture",
          "cells"
        ],
        "title": "HeatmapResponse",
        "type": "object"
      },
      "PieResponse": {
        "additionalProperties": false,
