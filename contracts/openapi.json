{
  "components": {
    "schemas": {
      "Bucket": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "description": "Exclusive local date",
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "partial": {
            "title": "Partial",
            "type": "boolean"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "partial"
        ],
        "title": "Bucket",
        "type": "object"
      },
      "CountryResponse": {
        "additionalProperties": false,
        "properties": {
          "countries": {
            "items": {
              "$ref": "#/components/schemas/CountryValue"
            },
            "title": "Countries",
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/DimensionCoverage"
          },
          "fixture": {
            "description": "True only for clearly marked synthetic stub responses",
            "title": "Fixture",
            "type": "boolean"
          },
          "generation": {
            "description": "Combined ingestion/enrichment invalidation generation",
            "minimum": 0.0,
            "title": "Generation",
            "type": "integer"
          },
          "last_updated": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "UTC ingestion freshness; null before import",
            "title": "Last Updated"
          },
          "partial_credit_note": {
            "default": "Only country-resolved unique credited artists share each listen.",
            "title": "Partial Credit Note",
            "type": "string"
          },
          "range": {
            "$ref": "#/components/schemas/DateRange"
          }
        },
        "required": [
          "range",
          "coverage",
          "last_updated",
          "generation",
          "fixture",
          "countries"
        ],
        "title": "CountryResponse",
        "type": "object"
      },
      "CountryValue": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Artist-associated ISO country",
            "pattern": "^(?:[A-WY-Z][A-Z]|X[A-DF-VX-Z])$",
            "title": "Code",
            "type": "string"
          },
          "listens": {
            "minimum": 0.0,
            "title": "Listens",
            "type": "number"
          },
          "share": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Share",
            "type": "number"
          }
        },
        "required": [
          "code",
          "listens",
          "share"
        ],
        "title": "CountryValue",
        "type": "object"
      },
      "Coverage": {
        "additionalProperties": false,
        "properties": {
          "excluded_listens": {
            "minimum": 0.0,
            "title": "Excluded Listens",
            "type": "integer"
          },
          "included_listens": {
            "minimum": 0.0,
            "title": "Included Listens",
            "type": "integer"
          },
          "total_listens": {
            "minimum": 0.0,
            "title": "Total Listens",
            "type": "integer"
          }
        },
        "required": [
          "total_listens",
          "included_listens",
          "excluded_listens"
        ],
        "title": "Coverage",
        "type": "object"
      },
      "DateRange": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "format": "date",
            "title": "From",
            "type": "string"
          },
          "to": {
            "format": "date",
            "title": "To",
            "type": "string"
          },
          "tz": {
            "description": "Canonical supported IANA timezone",
            "title": "Tz",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "tz"
        ],
        "title": "DateRange",
        "type": "object"
      },
      "DimensionCoverage": {
        "additionalProperties": false,
        "properties": {
          "albums": {
            "$ref": "#/components/schemas/Coverage"
          },
          "artists": {
            "$ref": "#/components/schemas/Coverage"
          },
          "countries": {
            "$ref": "#/components/schemas/Coverage"
          },
          "genres": {
            "$ref": "#/components/schemas/Coverage"
          },
          "listens": {
            "$ref": "#/components/schemas/Coverage"
          },
          "tracks": {
