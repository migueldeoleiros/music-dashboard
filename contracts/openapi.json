          "range",
          "coverage",
          "last_updated",
          "generation",
          "fixture",
          "dimension",
          "bucket_unit",
          "buckets",
          "series"
        ],
        "title": "EvolutionResponse",
        "type": "object"
      },
      "EvolutionSeries": {
        "additionalProperties": false,
        "properties": {
          "is_other": {
            "description": "Known categories outside whole-range top N, never unknown",
            "title": "Is Other",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "values": {
            "description": "Zero-filled, one value per bucket; not cumulative",
            "items": {
              "minimum": 0.0,
              "type": "number"
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "key",
          "label",
          "is_other",
          "values"
        ],
        "title": "EvolutionSeries",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/DimensionCoverage"
          },
          "generation": {
            "minimum": 0.0,
            "title": "Generation",
            "type": "integer"
          },
          "last_updated": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Updated"
          },
          "mode": {
            "enum": [
              "fixture",
              "live"
            ],
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "sync_lag_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null if no successful import",
            "title": "Sync Lag Seconds"
          }
        },
        "required": [
          "status",
          "mode",
          "last_updated",
          "sync_lag_seconds",
          "coverage",
          "generation"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HeatmapCell": {
        "additionalProperties": false,
