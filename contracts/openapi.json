              "genres"
            ],
            "title": "Dimension",
            "type": "string"
          },
          "fixture": {
            "description": "True only for clearly marked synthetic stub responses",
            "title": "Fixture",
            "type": "boolean"
          },
          "generation": {
            "description": "Combined ingestion/enrichment invalidation generation",
            "minimum": 0.0,
            "title": "Generation",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/RankedEntity"
            },
            "title": "Items",
