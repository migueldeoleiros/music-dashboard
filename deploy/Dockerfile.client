# Build context: repository root (docker build -f deploy/Dockerfile.client .)
FROM node:22-alpine AS build
WORKDIR /app/client
COPY client/package.json client/package-lock.json client/.npmrc ./
RUN npm ci
COPY client/ ./
# Generated API types are committed; contracts/ is only needed to regenerate.
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/proxy.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/client/dist /usr/share/nginx/html
EXPOSE 8080
