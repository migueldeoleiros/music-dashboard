#!/bin/sh
# Enforce Conventional Commits: type(scope)?!?: subject
msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | sed -n '1p')
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].*$'
if ! printf '%s' "$subject" | grep -Eq "$re"; then
  cat >&2 <<MSG
Commit rejected: subject is not a Conventional Commit.
  got:      $subject
  expected: <type>(<scope>)?: <subject>
  types:    feat fix docs style refactor perf test build ci chore revert
  example:  feat(ui): add artist page
MSG
  exit 1
fi
if [ ${#subject} -gt 120 ]; then
  echo "Commit rejected: subject longer than 120 chars (${#subject})." >&2; exit 1
fi
